# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/

# Environment files
# ignore ทุกไฟล์ .env* ก่อน แล้วค่อยปล่อยเฉพาะ *.example กลับมา
# ของเดิมระบุทีละชื่อ ทำให้ .env.production (ที่มีรหัสผ่าน production จริง)
# หลุดออกมาเป็นไฟล์ที่ git พร้อม track — อันตรายมากเพราะ repo นี้เป็น public
.env
.env.*
!.env.example
!.env.production.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Prisma
backend/prisma/migrations/*.sql.bak

# Compiled output of ts-node scripts run in place
backend/prisma/*.js
backend/prisma/*.js.map
backend/prisma/*.d.ts
backend/scripts/*.js
backend/scripts/*.js.map
backend/scripts/*.d.ts

# Uploads (local dev)
backend/uploads/

# Database backups
backups/

# Docker image ที่ build ไว้ส่งขึ้น server — ไฟล์ละหลายร้อย MB ห้ามเข้า git
# ยึดที่ root เท่านั้น ไม่ให้ไปบังโฟลเดอร์ images/ ของ asset ในอนาคต
/images/

# TypeScript
*.tsbuildinfo
